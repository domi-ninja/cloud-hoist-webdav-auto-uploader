{
  "name": "cloud-hoist",
  "version": "2026.10.0",
  "license": "GPL-3.0-or-later",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.102.8",
    "expo": "~57.0.20",
    "expo-build-properties": "~57.0.17",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-font": "~57.0.3",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.19",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.2.6",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-worklets": "0.10.0",
    "zod": "4.5.4"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "setup": "./scripts/setup.sh",
    "android": "./scripts/android/run.sh",
    "android:seed-account": "./scripts/android/seed-debug-account.sh",
    "android:seed-photos": "./scripts/android/seed-random-photos.sh",
    "android:signing": "sh scripts/android/release.sh init",
    "android:install": "sh scripts/android/install-release.sh",
    "check": "./scripts/test/all.sh",
    "icons": "node scripts/assets/generate-icons.mjs",
    "icons:check": "node scripts/assets/generate-icons.mjs --check",
    "test:android": "./scripts/test/android-instrumentation.sh",
    "test:deep-links": "./scripts/test/deep-links.sh",
    "prebuild": "expo prebuild --platform android",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest --runInBand",
    "test:account:live": "./scripts/test/account-live.sh",
    "test:native": "./scripts/test/native-unit.sh",
    "test:privacy": "./scripts/test/privacy.sh",
    "test:stress": "./scripts/test/stress.sh",
    "test:watch": "jest --watch",
    "android:release": "sh scripts/android/release.sh sign",
    "android:build": "CLOUD_HOIST_CHANNEL=beta sh scripts/fdroid/build.sh",
    "fdroid:prepare": "sh scripts/fdroid/prepare.sh",
    "fdroid:build": "sh scripts/fdroid/build.sh",
    "licenses:generate": "node scripts/fdroid/licenses.mjs",
    "licenses:check": "node scripts/fdroid/licenses.mjs --check",
    "test:release": "node --test scripts/android/release.test.mjs scripts/fdroid/attribution.test.mjs && python3 -m unittest discover -s scripts/fdroid -p '*_test.py'"
  },
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": "24.x"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "download"
    }
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/test-results/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/test-results/"
    ]
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@jest/globals": "^29.7.0",
    "@react-native/metro-config": "0.86.3",
    "@resvg/resvg-js": "^2.6.2",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.18",
    "babel-preset-expo": "^57.0.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          ".*"
        ]
      }
    }
  }
}
